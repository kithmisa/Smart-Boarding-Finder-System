# Frontend Environment Variables
# Copy this file to .env and update with your production values

# Backend API URL (update this to your deployed backend URL)
REACT_APP_API_URL=https://your-backend-app.railway.app

# Example URLs for different platforms:
# Railway: https://your-app-name.railway.app
# Render: https://your-app-name.onrender.com
# Heroku: https://your-app-name.herokuapp.com
# Vercel: https://your-backend-app.vercel.app

# Optional: App configuration
REACT_APP_APP_NAME=Smart Boarding Finder
REACT_APP_VERSION=1.0.0
