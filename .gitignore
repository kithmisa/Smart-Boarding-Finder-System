# Uploads directory - keep folder structure but ignore all images
backend/uploads/*.png
backend/uploads/*.jpg
backend/uploads/*.jpeg
backend/uploads/*.gif
backend/uploads/*.bmp
backend/uploads/*.webp
!backend/uploads/.gitkeep

# SQL files (database schemas, dumps, migrations)
*.sql
!**/migrations/*.sql
backend/database_schema.sql
backend/link_houses_with_owners.sql
backend/update_contact_table.sql

*.md